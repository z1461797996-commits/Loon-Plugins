#!name=天虹基础购物精简版
#!desc=基于实际 HAR：清理开屏/侧边广告/营销弹窗/新人券/会员推广/推荐信息流；过滤动态首页活动楼层与逛逛内容；保留门店、购物入口、搜索、商品详情、购物车、订单、配送和支付。
#!icon=https://raw.githubusercontent.com/z1461797996-commits/Loon-Plugins/main/tianhong-lite-icon.svg
#!category=去广告

[Rewrite]
# 明确广告接口：用请求重写拦截，避免只依赖策略组分流
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/scrm\/v1\/api\/advert\/side\/get(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/scrm\/v1\/api\/message\/popup\/get(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/scrm\/v1\/api\/registration\/coupon\/v2\/get\/newbie\/entrance\/banner(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/scrm\/v1\/api\/registration\/coupon\/v2\/getPopInfo(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/scrm\/v1\/api\/member\/activity-card\/config(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/scrm\/v1\/api\/member\/platinum-card\/pop-window\/get(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/scrm\/v1\/api\/message\/get-activity-info(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/advert-ms-app\/advert\/list(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/scrm\/v1\/api\/top-banner\/get(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/th-api\/v1\/product\/choiceness-recommend\/list(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/th-api\/v1\/product\/msgsenter\/recommend\/list(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/th-api\/v1\/product\/v2\/cart\/personal-recommend\/list(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/ai-diet-api\/ai-diet\/entrance\/home-page\/show(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/marketing-ms-app\/app\/start\/ad\/query(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/th-api\/v1\/marketing\/app\/start\/advertising\/get(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tianhong\.cn\/marketing-ms-app\/appPopWindows\/appSmallPopup(?:\?|$)/i then reject_dict(200)

[Script]
# 解析 dj_module_api/fetch 的 Base64(JSON)，清除活动/逛逛/营销模块
http-response ^https?:\/\/dj\.tianhong\.cn\/dj_module_api\/fetch(?:\?.*)?$ script-path=https://raw.githubusercontent.com/z1461797996-commits/Loon-Plugins/main/Tianhong_Basic_Shopping.js,timeout=20,requires-body=true,tag=天虹动态首页营销清理,enable=true
# 我的页只移除营销权益卡片，保留会员身份信息
http-response ^https?:\/\/api\.tianhong\.cn\/scrm\/v1\/api\/member\/home(?:\?.*)?$ script-path=https://raw.githubusercontent.com/z1461797996-commits/Loon-Plugins/main/Tianhong_Basic_Shopping.js,timeout=20,requires-body=true,tag=天虹会员营销清理,enable=true
# 消息列表只移除“活动优惠”会话，保留服务通知和交易物流
http-response ^https?:\/\/api\.tianhong\.cn\/scrm\/v1\/api\/message\/recent-contact\/page(?:\?.*)?$ script-path=https://raw.githubusercontent.com/z1461797996-commits/Loon-Plugins/main/Tianhong_Basic_Shopping.js,timeout=20,requires-body=true,tag=天虹活动消息清理,enable=true

# 说明：不拦截登录、门店、搜索、商品详情、商品主图、购物车主列表、
# 库存/价格、订单、配送、支付及售后接口；不拦截 api.tianhong.cn 整个域名。

[MITM]
hostname = api.tianhong.cn,dj.tianhong.cn
