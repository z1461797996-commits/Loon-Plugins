#!name=高德地图精简去广告
#!desc=精准屏蔽高德 AI 推荐/问答入口及已抓包确认的开屏广告请求；保留地图、导航、打车和路线规划。
#!icon=https://raw.githubusercontent.com/z1461797996-commits/Loon-Plugins/main/amap-lite-icon.svg
#!category=去广告

[Rewrite]
# AI 首页快捷问答与探索内容
request if ${url} ~= /^https:\/\/ai\.amap\.com\/v1\/ai_rec\/(?:home_qs|home_explore)(?:\?|$)/ then reject(403)

# 导航首页 AI 问答入口
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-aiqs(?:\?|$)/ then reject(403)

# 高德广告素材请求
request if ${url} ~= /^https:\/\/optimus-ads\.amap\.com\// then reject(403)

# 高德开屏商业广告素材请求
request if ${url} ~= /^https:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt(?:\?|$)/ then reject(403)

[MITM]
hostname = ai.amap.com,m5.amap.com,optimus-ads.amap.com,amap-aos-info-nogw.amap.com
